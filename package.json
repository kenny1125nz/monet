{
    "name": "monet",
    "version": "0.1.0",
    "description": "A CLI-based AI agent orchestrator for the PDCA loop — design, build, review.",
    "keywords": [
        "cli",
        "ai-agent",
        "architecture",
        "orchestrator"
    ],
    "homepage": "https://github.com/n/a#readme",
    "bugs": {
        "url": "https://github.com/n/a/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n/a.git"
    },
    "license": "MIT",
    "author": "kenny",
    "type": "module",
    "main": "index.js",
    "bin": {
        "monet": "dist/cli/index.js"
    },
    "directories": {
        "test": "tests"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "dev": "tsx watch src/cli/index.ts",
        "start": "node dist/cli/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.72",
        "@ai-sdk/openai": "^3.0.54",
        "ai": "^3.0.0",
        "chalk": "^5.3.0",
        "commander": "^12.0.0",
        "express": "^4.18.0",
        "inquirer": "^9.2.0",
        "marked": "^12.0.0",
        "ora": "^8.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.0",
        "@types/inquirer": "^9.0.0",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "tsx": "^4.7.0",
        "typescript": "^5.4.0",
        "vitest": "^1.6.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
